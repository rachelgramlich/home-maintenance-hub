# Copy to .streamlit/secrets.toml (gitignored) or use .env.

MAINTENANCE_WIZARD_STORE = "local"  # or "notion"
MAINTENANCE_WIZARD_TIMEZONE = "America/New_York"

# Notion (production) — see docs/NOTION_SETUP.md
NOTION_API_KEY = ""
MAINTENANCE_WIZARD_NOTION_TASKS_DS_ID = "collection://YOUR-TASKS-DS-ID"
MAINTENANCE_WIZARD_NOTION_CONTRACTORS_DS_ID = "collection://YOUR-CONTRACTORS-DS-ID"
MAINTENANCE_WIZARD_NOTION_COMPLETIONS_DS_ID = "collection://YOUR-COMPLETIONS-DS-ID"

# Optional: Ocala xlsx path for `just migrate-xlsx` (Home Maintenance tab only)
# MAINTENANCE_WIZARD_XLSX_PATH = "/path/to/home.xlsx"