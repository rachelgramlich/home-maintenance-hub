# Copy to secrets.toml (gitignored) or set environment variables.

# maintenance_wizard store: "local" (default) or "google_sheets"
MAINTENANCE_WIZARD_STORE = "local"

# Google Sheets (when STORE = google_sheets)
# MAINTENANCE_WIZARD_SHEET_ID = ""
# Path to OAuth token JSON from `just google-auth` (v1 optional)
# GOOGLE_SHEETS_TOKEN_PATH = ".local/maintenance_wizard/token.json"
# GOOGLE_OAUTH_CLIENT_SECRETS = ".local/maintenance_wizard/client_secret.json"

# Timezone for month boundaries (default America/New_York)
# MAINTENANCE_WIZARD_TIMEZONE = "America/New_York"