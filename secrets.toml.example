# Copy to .streamlit/secrets.toml (gitignored) or use .env.

STORE = "local"  # or "notion"
TIMEZONE = "America/New_York"
REQUIRE_AUTH = false
AUTH_EMAIL_ALLOWLIST = ""  # comma-separated Google emails for Cloud

[auth]
redirect_uri = "http://localhost:8765/oauth2callback"
client_id = ""
client_secret = ""
cookie_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Notion (production) — see docs/NOTION_SETUP.md
NOTION_API_KEY = ""
TASKS_DS_ID = "collection://YOUR-TASKS-DS-ID"
CONTRACTORS_DS_ID = "collection://YOUR-CONTRACTORS-DS-ID"
COMPLETIONS_DS_ID = "collection://YOUR-COMPLETIONS-DS-ID"

# Optional: Ocala xlsx path for `just migrate-xlsx` (Home Maintenance tab only)
# XLSX_PATH = "/path/to/home.xlsx"

# In-app feedback → GitHub Issues (label user-feedback-inbox)
GITHUB_FEEDBACK_REPOSITORY = "rachelgramlich/home-maintenance-hub"
GITHUB_FEEDBACK_TOKEN = ""
